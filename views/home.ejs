<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

<nav>

    <h2>🔗 ShortURL</h2>

    <div>

        Welcome,
        <strong><%= user.name %></strong>

        <a href="/user/logout" class="logout">
            Logout
        </a>

    </div>

</nav>

<div class="container">

    <div class="card">

        <h2>Create Short URL</h2>

        <form action="/" method="POST">

            <input
                type="text"
                name="redirectURL"
                placeholder="Paste Long URL Here..."
                required
            >

            <button>
                Shorten URL
            </button>

        </form>

    </div>

    <div class="table-card">

        <h2>Your URLs</h2>

        <table>

            <thead>

                <tr>

                    <th>Short URL</th>

                    <th>Original URL</th>

                    <th>Clicks</th>

                    <th>Copy</th>

                    <th>Delete</th>

                </tr>

            </thead>

            <tbody>

            <% urls.forEach((url)=>{ %>

                <tr>

                    <td>

                        <a
                        href="/<%= url.shortId %>"
                        target="_blank">

                        http://localhost:7001/<%= url.shortId %>

                        </a>

                    </td>

                    <td>

                        <%= url.redirectURL %>

                    </td>

                    <td>

                        <span class="clicks">

                            <%= url.clicks %>

                        </span>

                    </td>

                    <td>

                        <button
                        class="copy-btn"

                        onclick="copyURL('http://localhost:7001/<%= url.shortId %>')">

                        📋

                        </button>

                    </td>

                    <td>

                        <button class="delete-btn">

                            🗑

                        </button>

                    </td>

                </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>

<script src="/js/script.js"></script>

</body>
</html>