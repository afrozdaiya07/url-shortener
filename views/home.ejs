<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ShortURL Dashboard</title>

<link rel="stylesheet" href="/css/dashboard.css>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>

<div class="container">

<header>

<div class="logo">
<i class="fa-solid fa-link"></i>
<h2>Short<span>URL</span></h2>
</div>

<div class="user">

<p>Welcome,
<b><%= user.name %></b></p>

<a href="/logout" class="logout">Logout</a>

</div>

</header>

<div class="card">

<h1>Create Short URL</h1>

<form action="/shorturl" method="POST">

<input
type="url"
name="redirectURL"
placeholder="Paste Long URL Here..."
required>

<button>

<i class="fa-solid fa-wand-magic-sparkles"></i>

Shorten URL

</button>

</form>

</div>

<div class="card">

<h2>Your URLs</h2>

<table>

<thead>

<tr>

<th>Short URL</th>

<th>Original URL</th>

<th>Clicks</th>

<th>Copy</th>

<th>Delete</th>

</tr>

</thead>

<tbody>

<% urls.forEach(url=>{ %>

<tr>

<td>

<a href="/<%=url.shortId%>" target="_blank">

http://localhost:7001/<%=url.shortId%>

</a>

</td>

<td>

<%=url.redirectURL%>

</td>

<td>

<%=url.visitHistory.length%>

</td>

<td>

<button class="copyBtn"

data-url="http://localhost:7001/<%=url.shortId%>">

<i class="fa-regular fa-copy"></i>

Copy

</button>

</td>

<td>

<form action="/delete/<%=url._id%>"

method="POST">

<button class="deleteBtn">

<i class="fa-solid fa-trash"></i>

Delete

</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<footer>

Made with ❤️ by <b>Afroz Daiya</b>

</footer>

</div>

<script>

const copyBtns=document.querySelectorAll(".copyBtn");

copyBtns.forEach(btn=>{

btn.addEventListener("click",()=>{

navigator.clipboard.writeText(btn.dataset.url);

btn.innerHTML="✅ Copied";

setTimeout(()=>{

btn.innerHTML='<i class="fa-regular fa-copy"></i> Copy';

},1500);

});

});

</script>

</body>

</html>