<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup | Short URL</title>

    <link rel="stylesheet" href="/css/signup.css">
</head>
<body>

<div class="container">

    <div class="card">

        <h1>Create Account</h1>
        <p>Welcome! Create your Short URL account.</p>
        <% if(error){ %>

<div class="error">
    <%= error %>
</div>

<% } %>

        <form action="/user/signup" method="POST">

            <input
                type="text"
                name="name"
                placeholder="Full Name"
                required
            >

            <input
                type="email"
                name="email"
                placeholder="Email Address"
                required
            >

            <input
                type="password"
                name="password"
                placeholder="Password"
                required
            >

            <button type="submit">
                Create Account
            </button>

        </form>

        <div class="bottom">

            Already have an account?

            <a href="/user/login">
                Login
            </a>

        </div>

    </div>

</div>

</body>
</html>