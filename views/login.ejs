<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Short URL</title>

    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

<div class="container">

    <div class="card">

        <h1>Welcome Back </h1>
        <p>Login to manage your Short URLs.</p>
        <% if(error){ %>

<div class="error">
    <%= error %>
</div>

<% } %>

        <form action="/user/login" method="POST">

            <input
                type="email"
                name="email"
                placeholder="Email Address"
                required
            >

            <div class="password-box">
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Password"
                    required
                >

                <span id="togglePassword">
                    👁️
                </span>
            </div>

            <button type="submit">
                Login
            </button>

        </form>

        <div class="bottom">
            Don't have an account?

            <a href="/user/signup">
                Signup
            </a>
        </div>

    </div>

</div>

<script src="/js/script.js"></script>

</body>
</html>